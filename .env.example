PORT=3000
DATABASE_URL=postgresql://invoicing:invoicing@localhost:5434/invoicing

# Hacienda: sandbox. Production is realm "rut", client "api-prod" and api.comprobanteselectronicos.go.cr.
# Verify against Hacienda's current documentation before deploying.
HACIENDA_IDP_URL=https://idp.comprobanteselectronicos.go.cr/auth/realms/rut-stag/protocol/openid-connect/token
HACIENDA_CLIENT_ID=api-stag
HACIENDA_RECEPTION_URL=https://api-sandbox.comprobanteselectronicos.go.cr/recepcion/v1
# Optional: only if Hacienda can reach this service. Polling works without it.
HACIENDA_CALLBACK_URL=
HACIENDA_PUBLIC_API_URL=https://api.hacienda.go.cr

# Cédula of whoever develops this software (ProveedorSistemas). Not necessarily the emitter's.
SOFTWARE_PROVIDER_ID=

# openssl rand -hex 32
CERT_ENCRYPTION_KEY=
# openssl rand -hex 32
WEBHOOK_SECRET=
# openssl rand -hex 32 — admin routes (emitters, certificates, clients)
ADMIN_API_KEY=
